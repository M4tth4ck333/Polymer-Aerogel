# Graustufen-Einlesen & Normalisierung auf 8-Bit
def imread_gray_8bit(path: str):
    img = io.imread(path)
    if img.ndim == 3: # Falls es ein Farbbild ist
        if img.dtype != np.uint8:
            img = cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)
        img = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)
    else: # Falls es bereits ein Graustufenbild ist
        if img.dtype != np.uint8:
            img = cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)
    return img

# Bildverbesserung und -verarbeitung
def enhance_contrast(img): 
    # Erhöht den lokalen Kontrast mit CLAHE (Contrast Limited Adaptive Histogram Equalization)
    return cv2.createCLAHE(2.0, (8,8)).apply(img)

def denoise(img): 
    # Rauschunterdrückung durch einen bilateralen Filter (erhält Kanten)
    return cv2.bilateralFilter(img, 5, 10, 10)

def binarize_pores(img):
    # Binarisierung: Trennung von Poren und Festkörper
    blur = cv2.GaussianBlur(img, (3, 3), 0)
    # Globale Otsu-Schwellenwertbildung
    _, otsu = cv2.threshold(blur, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    # Lokale adaptive Schwellenwertbildung
    ad = cv2.adaptiveThreshold(blur, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 35, 5)
    # Kombiniert beide Methoden: Wenn eine der Methoden eine Pore erkennt, wird es als Pore gewertet
    comb = ((otsu > 0).astype(np.uint8) + (ad > 0).astype(np.uint8)) >= 1
    # Plausibilitätsprüfung der Porosität (zwischen 20% und 95%)
    return comb if 0.2 <= comb.mean() <= 0.95 else (~comb)

def clean_binary(bin_img): 
    # Entfernt kleine Störobjekte und schließt winzige Löcher (alles unter 25 Pixeln wird ignoriert)
    return remove_small_holes(remove_small_objects(bin_img, 25), 25)

# Merkmalsanalyse
def eq_diameter_from_region(region): 
    # Berechnet den äquivalenten Durchmesser (Durchmesser eines Kreises mit gleicher Fläche)
    return region.equivalent_diameter

def compute_shape_descriptors(regions):
    circularities, aspect_ratios, solidities, eq_diams = [], [], [], []
    for r in regions:
        area = r.area
        perimeter = r.perimeter if r.perimeter > 0 else 1.0
        # Zirkularität (Wie kreisrund ist die Pore?)
        circularity = 4.0 * math.pi * area / (perimeter ** 2)
        minr, minc, maxr, maxc = r.bbox
        h = maxr - minr; w = maxc - minc
        # Seitenverhältnis der Bounding Box
        ar = (max(h, w) / (min(h, w) + 1e-6))
        
        circularities.append(circularity)
        aspect_ratios.append(ar)
        solidities.append(r.solidity if hasattr(r, "solidity") else np.nan)
        eq_diams.append(eq_diameter_from_region(r))
        
    return (np.nanmean(circularities), np.nanmean(aspect_ratios),
            np.nanmean(solidities), eq_diams)

def distance_watershed(binary_mask):
    # Trennt verbundene Poren mithilfe einer Distanztransformation und des Watershed-Algorithmus
    distance = ndi.distance_transform_edt(binary_mask)
    local_max = morphology.local_maxima(distance) # Sucht die tiefsten Punkte der Poren
    markers, _ = ndi.label(local_max)
    return watershed(-distance, markers, mask=binary_mask)

def skeleton_metrics(solid_mask):
    # Analysiert das Gerüst (Skelett) des Festkörpers
    skel = skeletonize(solid_mask)
    length_px = skel.sum()
    area_px = skel.size
    density = length_px / area_px # Skelettdichte
    # Definiert einen Kernel, um Nachbarn zu zählen
    kernel = np.array([[1,1,1],[1,10,1],[1,1,1]], dtype=np.uint8)
    neigh = cv2.filter2D(skel.astype(np.uint8), -1, kernel)
    neighbors = neigh - 10
    # Gibt Dichte, Anzahl der Verzweigungspunkte (>=3) und Endpunkte (1) zurück
    return (density, int(((neighbors >= 3) & skel).sum()), int(((neighbors == 1) & skel).sum()))

def fractal_dimension(binary_mask):
    # Berechnet die fraktale Dimension mittels Box-Counting-Methode (Komplexität der Struktur)
    img = util.img_as_ubyte(binary_mask > 0)
    sizes, counts = [], []
    h, w = img.shape
    s = 1
    while s <= min(h, w):
        cropped = img[:(h // s) * s, :(w // s) * s]
        view = cropped.reshape((h // s, s, w // s, s))
        block_sum = view.sum(axis=(1,3))
        count = np.count_nonzero(block_sum)
        if count > 0:
            sizes.append(1.0 / s)
            counts.append(count)
        s *= 2
    if len(sizes) < 2: return np.nan
    return float(np.polyfit(np.log(sizes), np.log(counts), 1)[0])

